{
  "name": "age-three",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "npm run dev -w @age3/web",
    "dev:server": "go -C apps/server run ./cmd/server",
    "build": "npm run build -w @age3/web",
    "preview": "npm run preview -w @age3/web",
    "typecheck": "tsc -p packages/core && tsc -p packages/protocol && npm run check -w @age3/web",
    "test": "vitest run",
    "test:server": "go -C apps/server test ./...",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:test": "npm run build:test -w @age3/web && netlify deploy --prod --no-build --dir apps/web/dist --site 9024495a-24bc-47b8-baeb-724285920c9c --filter @age3/web",
    "deploy:main": "netlify deploy --prod --no-build --dir sites/coming-soon --site ac81c648-d8fc-44e1-b443-8517d719c314 --filter @age3/web"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-svelte": "2.46.1",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "prettier-plugin-svelte": "3.3.3",
    "svelte-eslint-parser": "0.43.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.18.2",
    "vitest": "2.1.8"
  },
  "overrides": {
    "svelte": "5.19.0",
    "vite": "5.4.14"
  }
}
