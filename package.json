{
  "name": "age-three",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "npm run dev -w @age3/web",
    "build": "npm run build -w @age3/web",
    "preview": "npm run preview -w @age3/web",
    "typecheck": "tsc -p packages/core && tsc -p packages/protocol && npm run check -w @age3/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-svelte": "2.46.1",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "prettier-plugin-svelte": "3.3.3",
    "svelte-eslint-parser": "0.43.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.18.2",
    "vitest": "2.1.8"
  },
  "overrides": {
    "svelte": "5.19.0"
  }
}
